<?xml version="1.0" encoding="utf-8"?>
<!-- v1.7: language switcher card added at the top. All v1.6 field IDs
     preserved. NOT BUILT, NOT TESTED. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- ===== v1.7: language card ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <View
                    android:layout_width="4dp"
                    android:layout_height="20dp"
                    android:background="@drawable/bg_accent_bar_cyan" />
                <TextView
                    style="@style/CardTitle"
                    android:layout_marginStart="8dp"
                    android:text="@string/settings_lang_title" />
            </LinearLayout>

            <RadioGroup
                android:id="@+id/radioLangGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radioLangArabic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/accent_red"
                    android:text="@string/settings_lang_arabic"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/radioLangEnglish"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:buttonTint="@color/accent_red"
                    android:text="@string/settings_lang_english"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- ===== existing pacing/thresholds card (unchanged IDs) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/FieldLabel"
                android:text="@string/settings_field_threshold_label" />

            <TextView
                style="@style/FieldHint"
                android:text="@string/settings_field_threshold_hint" />

            <EditText
                android:id="@+id/edtThresholdDays"
                style="@style/FieldInput"
                android:inputType="number"
                android:text="180" />

            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="18dp"
                android:text="@string/settings_field_day_cap_label" />

            <TextView
                style="@style/FieldHint"
                android:text="@string/settings_field_day_cap_hint" />

            <EditText
                android:id="@+id/edtDayCap"
                style="@style/FieldInput"
                android:inputType="number"
                android:text="60" />

            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="18dp"
                android:text="@string/settings_field_hour_cap_label" />

            <TextView
                style="@style/FieldHint"
                android:text="@string/settings_field_hour_cap_hint" />

            <EditText
                android:id="@+id/edtHourCap"
                style="@style/FieldInput"
                android:inputType="number"
                android:text="12" />

            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="18dp"
                android:text="@string/settings_field_gap_min_label" />

            <TextView
                style="@style/FieldHint"
                android:text="@string/settings_field_gap_min_hint" />

            <EditText
                android:id="@+id/edtGapMin"
                style="@style/FieldInput"
                android:inputType="number"
                android:text="30" />

            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="18dp"
                android:text="@string/settings_field_gap_max_label" />

            <TextView
                style="@style/FieldHint"
                android:text="@string/settings_field_gap_max_hint" />

            <EditText
                android:id="@+id/edtGapMax"
                style="@style/FieldInput"
                android:inputType="number"
                android:text="120" />

            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="18dp"
                android:text="@string/settings_field_batch_label" />

            <TextView
                style="@style/FieldHint"
                android:text="@string/settings_field_batch_hint" />

            <EditText
                android:id="@+id/edtBatchSize"
                style="@style/FieldInput"
                android:inputType="number"
                android:text="12" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveSettings"
            style="@style/BtnPrimary"
            android:layout_width="match_parent"
            android:layout_marginTop="16dp"
            android:text="@string/settings_btn_save" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_confirm"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/settings_note"
                android:textColor="#F5E9C8"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
