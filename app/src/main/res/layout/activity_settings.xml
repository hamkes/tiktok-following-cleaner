<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="@string/settings_title"
            android:textColor="#00F2FE"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_threshold_label"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/editThresholdDays"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="#151C2C"
            android:inputType="number"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/settings_max_batch_label"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/editMaxBatch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="#151C2C"
            android:inputType="number"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="#FFFFFF" />

        <CheckBox
            android:id="@+id/cbUnfollowGone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/settings_unfollow_gone"
            android:textColor="#F8FAFC" />

        <CheckBox
            android:id="@+id/cbUnfollowFake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_unfollow_fake"
            android:textColor="#F8FAFC" />

        <CheckBox
            android:id="@+id/cbUnfollowDead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_unfollow_dead"
            android:textColor="#F8FAFC" />

        <CheckBox
            android:id="@+id/cbProtectFriends"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_protect_friends"
            android:textColor="#10B981" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="20dp"
            android:background="#00F2FE"
            android:text="@string/settings_save"
            android:textColor="#0B0E14"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnClearData"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="#334155"
            android:text="@string/settings_clear_data"
            android:textColor="#FE2C55" />

    </LinearLayout>
</ScrollView>
