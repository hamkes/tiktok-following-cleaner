<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top App Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="#F8FAFC"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnToggleLang"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="#1E293B"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="AR / EN"
                android:textColor="#00F2FE"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnOpenSettings"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="#1E293B"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="⚙️"
                android:textColor="#F8FAFC"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Service Status & Permissions Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#151C2C"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtServiceDot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textColor="#10B981"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/txtServiceStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/service_status_active"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnEnableService"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="#FE2C55"
                    android:text="@string/btn_enable_service"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnEnableOverlay"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="#1E293B"
                    android:text="@string/btn_enable_overlay"
                    android:textColor="#00F2FE"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Speed Mode Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#151C2C"
            android:orientation="horizontal"
            android:padding="6dp">

            <Button
                android:id="@+id/btnSpeedTurbo"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="@string/speed_turbo"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnSpeedHybrid"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/speed_hybrid"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnSpeedSafe"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/speed_safe"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 4 Live KPI Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#151C2C"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">
                <TextView
                    android:id="@+id/txtStatTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#00F2FE"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_total_audited"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="#151C2C"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">
                <TextView
                    android:id="@+id/txtStatCandidates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FE2C55"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_candidates"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="#151C2C"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">
                <TextView
                    android:id="@+id/txtStatActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#10B981"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_active"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="#151C2C"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">
                <TextView
                    android:id="@+id/txtStatSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="جاهز"
                    android:textColor="#F59E0B"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_speed"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Progress Bar & Live Phase Subtitle -->
        <TextView
            android:id="@+id/txtPhaseBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/status_ready_subtitle"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/progressAudit"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="6dp"
            android:progressTint="#00F2FE" />

        <!-- Primary Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStartAudit"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="#00F2FE"
                android:text="@string/btn_start_audit"
                android:textColor="#0B0E14"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnResumeAudit"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="#1E293B"
                android:text="@string/btn_resume_audit"
                android:textColor="#00F2FE"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnUnfollowSelected"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="#FE2C55"
                android:text="@string/btn_unfollow_selected"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStopRun"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="#334155"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="@string/btn_stop_run"
                android:textColor="#F8FAFC"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Search & Category Filter Strip -->
        <EditText
            android:id="@+id/editSearch"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="14dp"
            android:background="#151C2C"
            android:hint="@string/search_hint"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:singleLine="true"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#1E293B"
                    android:padding="8dp"
                    android:text="@string/chip_all"
                    android:textColor="#00F2FE"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipCandidates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="#1E293B"
                    android:padding="8dp"
                    android:text="@string/chip_candidates"
                    android:textColor="#FE2C55"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipGone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="#1E293B"
                    android:padding="8dp"
                    android:text="@string/chip_gone"
                    android:textColor="#EF4444"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipFake"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="#1E293B"
                    android:padding="8dp"
                    android:text="@string/chip_fake"
                    android:textColor="#F59E0B"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipDead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="#1E293B"
                    android:padding="8dp"
                    android:text="@string/chip_dead"
                    android:textColor="#FB7185"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="#1E293B"
                    android:padding="8dp"
                    android:text="@string/chip_active"
                    android:textColor="#10B981"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipUnknown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="#1E293B"
                    android:padding="8dp"
                    android:text="@string/chip_unknown"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Accounts List Container -->
        <LinearLayout
            android:id="@+id/listContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <!-- Diagnostic Console Header & Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnExportCsv"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="#1E293B"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="@string/btn_export_csv"
                android:textColor="#00F2FE"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnCopyLog"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="#1E293B"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="@string/btn_copy_log"
                android:textColor="#E2E8F0"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnClearLog"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="#1E293B"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="@string/btn_clear_log"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#080B10"
            android:fontFamily="monospace"
            android:minHeight="110dp"
            android:padding="10dp"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
