<?xml version="1.0" encoding="utf-8"?>
<!-- v1.4 launcher icon background: dark gradient square (the system mask
     crops it to circle/squircle/etc. on API 26+). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:endColor="#0B0B0F"
        android:startColor="#2A2A35"
        android:type="linear" />
</shape>
