    <!-- Card: floating bubble -->
    <string name="card_bubble_title">الأيقونة العائمة</string>
    <string name="bubble_body">فقاعة تحكم صغيرة (مثل أيقونة Messenger) تظهر فوق TikTok أثناء التشغيل فقط: إيقاف مؤقت / استئناف وإيقاف فوري من دون مغادرة TikTok. تحتاج إذن «العرض فوق التطبيقات الأخرى» — وهو الإذن الوحيد الذي يطلبه هذا التطبيق. من دونه يعمل كل شيء كما في السابق، بلا أيقونة.</string>
    <string name="bubble_status_format">إذن العرض فوق التطبيقات الأخرى: %1$s</string>
    <string name="bubble_status_granted">ممنوح ✓</string>
